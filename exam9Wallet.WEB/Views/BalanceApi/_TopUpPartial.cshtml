@model exam9Wallet.ViewModels.TopUpViewModel

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div id="alertContainer" class="alert d-none shadow-sm" role="alert"></div>

        <form id="topUpForm" class="px-3 py-4 border rounded-3 bg-light shadow-sm">
            <h3 class="text-center mb-4 fw-bold">Пополнение счета</h3>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3 w-75 mx-auto form-group">
                <label asp-for="UniqueCode" class="form-label"></label><br />
                <input class="form-control w-100" asp-for="UniqueCode" required placeholder="Например: 123456" />
                <span asp-validation-for="UniqueCode" class="text-danger"></span>
            </div>

            <div class="mb-3 w-75 mx-auto form-group">
                <label asp-for="Amount" class="form-label"></label><br />
                <input class="form-control w-100" asp-for="Amount" type="number" step="0.01" min="50" max="50000" required placeholder="Введите сумму" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="mb-2 w-75 mx-auto form-group d-grid">
                <button type="submit" class="btn btn-success btn-lg" id="submitBtn">Пополнить</button>
            </div>
        </form>
    </div>
</div>