@model IEnumerable<exam9Wallet.DAL.Models.Transaction>

@{
    ViewData["Title"] = "Журнал транзакций";
    var currentUserId = (int)ViewData["CurrentUserId"]!;
}

<div class="container mt-4">
    <h2 class="mb-4">Журнал транзакций</h2>

    <form method="get" asp-controller="Transaction" asp-action="Index" class="row g-3 align-items-end mb-4 p-3 bg-light rounded shadow-sm">
        <div class="col-md-4">
            <label for="from" class="form-label font-weight-bold">Дата с:</label>
            <input type="date" id="from" name="from" value="@Context.Request.Query["from"]" class="form-control" />
        </div>
        <div class="col-md-4">
            <label for="to" class="form-label font-weight-bold">Дата по:</label>
            <input type="date" id="to" name="to" value="@Context.Request.Query["to"]" class="form-control" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-50">Применить</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-50">Сбросить</a>
        </div>
    </form>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Дата и время</th>
                    <th scope="col">Тип операции</th>
                    <th scope="col">Контрагент</th>
                    <th scope="col" class="text-end">Сумма (сом)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        bool isIncome = item.ReceiverId == currentUserId;
                        bool isTopUp = item.SenderId == null;

                        <tr>
                            <td>@item.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (isTopUp)
                                {
                                    <span class="badge bg-info text-dark">Пополнение</span>
                                }
                                else if (isIncome)
                                {
                                    <span class="badge bg-success">Перевод (Приход)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Перевод (Расход)</span>
                                }
                            </td>
                            <td>
                                @if (isTopUp)
                                {
                                    <span class="text-muted">Анонимное / Терминал</span>
                                }
                                else if (isIncome)
                                {
                                    <span>От счета №<strong>@(item.Sender?.UniqueCode ?? item.SenderId)</strong></span>
                                }
                                else
                                {
                                    <span>На счет №<strong>@(item.Receiver?.UniqueCode ?? item.ReceiverId)</strong></span>
                                }
                            </td>
                            <td class="text-end fw-bold @(isIncome ? "text-success" : "text-danger")">
                                @(isIncome ? "+" : "-")@item.Amount.ToString("N2")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            Записи транзакций за указанный период не найдены.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>