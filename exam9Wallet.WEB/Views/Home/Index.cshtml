@{
    ViewData["Title"] = "Главная страница";
}

<div class="container mt-5">
    @if (User.Identity!.IsAuthenticated)
    {
        <p class="text-center">Добро пожаловать!</p>
        
        @await Html.PartialAsync("~/Views/BalanceApi/_TransferPartrialView.cshtml", new exam9Wallet.ViewModels.TransferViewModel())
    }
    else
    {
        <p class="text-center"><a asp-controller="Account" asp-action="Login">Войти в аккаунт</a></p>
    }
    <div class="mt-3">
        @await Html.PartialAsync("~/Views/BalanceApi/_TopUpPartial.cshtml", new exam9Wallet.ViewModels.TopUpViewModel())
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");
    <script>
        $('#topUpForm').on('submit', function (e) {
            e.preventDefault();

            const $alert = $('#alertContainer');
            const $btn = $('#submitBtn');
            
            $alert.addClass('d-none').removeClass('alert-success alert-danger');

            const formData = {
                uniqueCode: parseInt($('#UniqueCode').val()),
                amount: parseFloat($('#Amount').val())
            };

            $btn.prop('disabled', true).text('Обработка...');

            $.ajax({
                url: '/api/balance/topup',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    $alert.removeClass('d-none').addClass('alert-success').text(response.message);
                    $('#topUpForm')[0].reset();
                },
                error: function (xhr) {
                    let errorMessage = "Произошла ошибка при отправке запроса.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    $alert.removeClass('d-none').addClass('alert-danger').text(errorMessage);
                },
                complete: function () {
                    $btn.prop('disabled', false).text('Пополнить');
                }
            });
        });


        $('#transferForm').on('submit', function (e) {
            e.preventDefault();

            const $alert = $('#transferAlertContainer');
            const $btn = $('#transferSubmitBtn');

            $alert.addClass('d-none').removeClass('alert-success alert-danger');

            const formData = {
                uniqueCode: parseInt($('#transferUniqueCode').val()),
                amount: parseFloat($('#transferAmount').val())
            };

            $btn.prop('disabled', true).text('Обработка...');

            $.ajax({
                url: '/api/balance/transfer',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    $alert.removeClass('d-none').addClass('alert-success').text(response.message);
                    $('#transferForm')[0].reset();
                },
                error: function (xhr) {
                    let errorMessage = "Произошла ошибка при отправке запроса.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    $alert.removeClass('d-none').addClass('alert-danger').text(errorMessage);
                },
                complete: function () {
                    $btn.prop('disabled', false).text('Перевести');
                }
            });
        });
    </script>
    }
}