@model exam9Wallet.DAL.Models.User

@{
    ViewData["Title"] = "Успешная регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 p-4 text-center">
                <div class="card-body">
                    
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>

                    <h4 class="card-title fw-bold mb-3">Вы успешно зарегистрировались</h4>

                    <p class="text-muted mb-2">Ваш уникальный код, не потеряйте его!:</p>

                    <div class="p-3 bg-light rounded border fs-2 fw-bold text-dark font-monospace mb-4">
                        @Model.UniqueCode
                    </div>

                    <div class="d-grid">
                        <a asp-controller="Home" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-primary btn-lg">Перейти на главную</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>